# Get a free key at https://aistudio.google.com/apikey
# Only used when USE_VERTEX=false. Double-check this key's project has NO
# billing account attached -- a Prepay-billed key defeats the zero-cost goal.
GEMINI_API_KEY=

# Vertex AI mode (USE_VERTEX=true): use instead of GEMINI_API_KEY when the
# AI Studio key's project has billing attached. Auth is via
# `gcloud auth application-default login`, not an API key -- run that once
# locally before using this mode. VERTEX_LOCATION_LIVE/TEXT differ because
# the Live and text models are only reachable at different Vertex regions
# for the same project (confirmed by testing).
USE_VERTEX=false
VERTEX_PROJECT=
VERTEX_LOCATION_LIVE=us-central1
VERTEX_LOCATION_TEXT=global

# Live API settings — never hardcode these in logic, change here if Google updates names/rates.
# Current default per https://ai.google.dev/gemini-api/docs/models (checked 2026-10-14).
LIVE_MODEL_NAME=gemini-3.8-live
LIVE_INPUT_SAMPLE_RATE_HZ=16000
LIVE_OUTPUT_SAMPLE_RATE_HZ=24000
LIVE_INPUT_MIME_TYPE=audio/pcm;rate=16000
TEXT_MODEL_NAME=gemini-3.8-flash

# Local Postgres (matches db/docker-compose.yml)
DATABASE_URL=postgresql://clinic:clinic@localhost:5432/clinic

# Cloud SQL connection (Cloud Run deployment only -- see README's
# "Deployment" section). Leave all empty for local dev; when
# CLOUD_SQL_CONNECTION_NAME is set, app/db.py connects via the Unix
# socket Cloud Run mounts instead of DATABASE_URL above.
CLOUD_SQL_CONNECTION_NAME=
DB_USER=clinic
DB_PASSWORD=
DB_NAME=clinic

# Design rule 3: require explicit confirmation before book/reschedule/cancel writes.
# Set to false only to run the no-confirmation ablation in Phase 4.
REQUIRE_CONFIRMATION=true

# Gates /admin.html and its API (username "admin"). Empty = dashboard
# disabled (503), not left open. Not a real auth system -- see
# docs/privacy.md's "Known gaps".
ADMIN_PASSWORD=
